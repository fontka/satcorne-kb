#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
	&kp ESC	&kp Q	&kp W	&kp E	&kp R	&kp T	&bootloader
	&kp TAB	&kp A	&kp S	&kp D	&kp F	&kp G	&sys_reset
	&kp LCTRL	&kp Z	&kp X	&kp C	&kp V	&kp B
					&kp ALT	&kp ENTER	&kp SPACE

	&kp C_MUTE	&kp Y	&kp U	&kp I	&kp O	&kp P	&bootloader
	&kp SEMI	&kp H	&kp J	&kp K	&kp L	&kp TILDE	&kp RSHFT
		&kp N	&kp M	&kp LT	&kp GT	&kp ENTER	&sys_reset
	&kp SPACE	&kp RALT	&kp RCTRL
            >;
        };
    };
};